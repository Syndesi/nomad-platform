# Builds runsc (gVisor's OCI runtime) from source for one OS variant.
#   docker build -f Dockerfile.gvisor --target out --build-arg VERSION=20261102.0 --build-arg GO_COMMIT=<sha> \
#                --build-arg VARIANT=alpine|debian --output type=local,dest=<dir> .
#
# gVisor's own build is Bazel, but its `go` branch is a synthetic branch with plain Go sources (and the prebuilt sighandler stub)
# that builds with `go build`, CGO off. Each commit of that branch merges one commit of master; the release tag release-<VERSION> points
# at a master commit, and GO_COMMIT is the `go` branch commit that merges exactly that one. verify-gvisor.sh checks both ends.
# CGO off means a static binary: the alpine and debian builds differ only in the toolchain image. Both are built anyway so every OS
# variant has an artifact built the same way as nomad and consul.
# runsc starts "sidecars" from a gvisor-bin/ directory next to it: three more Go programs and three tiny freestanding C programs
# (flags from their BUILD files in the master repo, no libc involved). The result is one tar: runsc + gvisor-bin/*.
# No defaults on purpose: binaries/build-runsc.sh passes everything from the cluster's .env.
ARG VARIANT
ARG ALPINE_VERSION
ARG DEBIAN_VERSION
ARG GO_VERSION

FROM golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS go-alpine
FROM golang:${GO_VERSION}-trixie AS go-debian
FROM go-${VARIANT} AS go

FROM alpine:${ALPINE_VERSION} AS base-alpine
RUN apk add --no-cache git bash tar build-base linux-headers

FROM debian:${DEBIAN_VERSION} AS base-debian
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git bash build-essential \
 && rm -rf /var/lib/apt/lists/*

FROM base-${VARIANT} AS build
ARG VARIANT
ARG VERSION
ARG GO_COMMIT
COPY --from=go /usr/local/go/ /usr/local/go/
ENV PATH="/usr/local/go/bin:${PATH}" CGO_ENABLED=0

COPY verify-gvisor.sh /verify-gvisor.sh
WORKDIR /src
RUN git init -q . && git remote add origin https://github.com/google/gvisor.git \
 && git fetch -q --depth 1 origin "${GO_COMMIT}" \
 && git checkout -q FETCH_HEAD \
 && /verify-gvisor.sh "${VERSION}" "${GO_COMMIT}"

# -trimpath and the version in the binary the way gVisor's release build does it (runsc --version prints it).
# The sidecar names are the ones in runsc/gvisorbinaries/gvisorbinaries.go.
RUN --mount=type=cache,id=go-mod,target=/root/go/pkg/mod \
    --mount=type=cache,id=go-build-${VARIANT},target=/root/.cache/go-build \
    mkdir -p /out/gvisor-bin \
 && flags="-trimpath -ldflags=-s\ -w\ -X\ gvisor.dev/gvisor/runsc/version.version=release-${VERSION}" \
 && eval go build $flags -o /out/runsc ./runsc \
 && eval go build $flags -o /out/gvisor-bin/gvisor_sentry ./runsc/cmd/sentry \
 && eval go build $flags -o /out/gvisor-bin/runsc-metric-server ./runsc/cmd/metricserver \
 && eval go build $flags -o /out/gvisor-bin/checkpointgofer ./runsc/checkpointgofer

# (the prewarmer is also linked without a PIE and without startfiles; fdparking is `-fno-pie`, the others get the same through -static)
RUN cflags="-Os -ffreestanding -fno-sanitize=all -fno-stack-protector -fno-asynchronous-unwind-tables -fno-unwind-tables -static -nostdlib -nostartfiles -Wl,--build-id=none -Wl,--gc-sections -Wl,-s -Wl,-n" \
 && gcc $cflags -fno-pie -no-pie -o /out/gvisor-bin/gvisor-sentry-prewarmer runsc/prewarmer/prewarmer.c \
 && gcc $cflags -fno-pie -no-pie -o /out/gvisor-bin/runsc-fd-parking runsc/fdparking/fdparking.c \
 && gcc $cflags -fno-pie -no-pie -o /out/gvisor-bin/gvisor-proc-umounter runsc/procumounter/procumounter.c

# Fixed owner and mtime, sorted: the same inputs give the same tar.
RUN cd /out && /out/runsc --version | head -1 \
 && tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='2000-01-01 00:00Z' -cf /runsc.tar runsc gvisor-bin

FROM scratch AS out
COPY --from=build /runsc.tar /runsc.tar
