# Name of this cluster: used for the tools container, the CA subject and the consul node ids. Lower case, no spaces.
CLUSTER_NAME=example

# Optional: replace the remote shell of the scripts and the tofu tunnel (default: ssh as the ansible user,
# %HOST% = node name as in the inventory)
# CLUSTER_EXEC=

# The tools container (docker compose of the platform). Do not use ${HOME} in this file, the Taskfile's dotenv does not expand it.
COMPOSE_FILE=base/tools/compose.yml
COMPOSE_PROJECT_NAME=example
TOFU_VERSION=1.13.9
ALPINE_VERSION=3.24

# Custom binaries (built from source into a cache shared by all clusters by `task build`)
NOMAD_VERSION=2.1.1
CONSUL_VERSION=2.1.0
GO_VERSION=1.27
# Ubuntu binaries link against glibc: build on the OLDEST Ubuntu you want to support (26.04: the platform needs OpenSSH with mlkem768x25519-sha256).
UBUNTU_BUILD_VERSION=26.04
# default: ~/.cache/nomad-platform/artifacts
# ARTIFACTS_DIR=

# Optional: where the age private key and the ssh key live (default ./secrets/age, ./secrets/ssh, git-ignored)
# AGE_KEY_DIR=
# SSH_KEY_DIR=
