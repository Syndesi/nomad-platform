# {{ ansible_managed }}
# The resolver of containers WITHOUT internet access (the firewall sends the containers of the network "{{ cluster_egress_cni_name }}" to the full one):
# *.consul and the names in /etc/hosts (this node's names), nothing from the internet - every other name gets NXDOMAIN.
no-resolv
# every name that is not forwarded below is answered here (NXDOMAIN, or an empty answer for a type the name lacks) instead of refused: a resolver
# that gets REFUSED for the AAAA of a known name may fail the whole lookup
local=/#/
server=/consul/127.0.0.1#{{ cluster_dns_consul_port }}
{% if cluster_authelia_oidc_clients | length > 0 or cluster_authelia_oidc_clients_public | length > 0 %}
# The OpenID Connect provider (authelia-internal, docs/reference.md): a container's own loopback. The allocation of an app that logs in with it has a mesh sidecar there on
# port 443 (an upstream to authelia-internal); in every other container the name leads nowhere (it did not resolve before).
# (host-record, not address=: address= answers NXDOMAIN for the AAAA query, and musl then fails the whole lookup)
{% if cluster_authelia_oidc_clients | length > 0 %}
host-record=auth.{{ cluster_internal_zone }},127.0.0.1
{% endif %}
{% if cluster_authelia_oidc_clients_public | length > 0 %}
host-record=auth.{{ cluster_domain }},127.0.0.1
{% endif %}
{% endif %}
listen-address={{ cluster_dns_docker_bridge_ip }}
bind-dynamic
