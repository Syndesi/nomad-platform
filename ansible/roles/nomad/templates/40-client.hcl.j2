# {{ ansible_managed }}
client {
  enabled = true
  # service addresses and published ports use this interface
  network_interface = "{{ nomad_interface }}"
  # consul connect: sidecars run in a bridge network built from these cni plugins
  cni_path = "{{ nomad_cni_path }}"
  # nomad's built-in bridge (mode = "bridge"); the firewall and dns rules know this subnet. Network "{{ cluster_egress_cni_name }}" ({{ cluster_egress_bridge }},
  # {{ cluster_egress_bridge_subnet }}, mode = "cni/{{ cluster_egress_cni_name }}", /opt/cni/config) is read at start: this comment makes a change restart the agent.
  bridge_network_subnet = "{{ cluster_nomad_bridge_subnet }}"
  options {
    # drivers this cluster does not use (nomad_driver_denylist): exec, java and qemu run on the host's network and bypass the container
    # firewall; mock_driver is for nomad's own tests. raw_exec is off by default (plugin not enabled).
    "driver.denylist" = {{ nomad_driver_denylist | join(',') | to_json }}
  }
  servers = {{ (cluster_servers_addrs | map('regex_replace', '$', ':4647') | list) | to_json }}
{% if nomad_client_meta %}
  meta {
{% for k, v in nomad_client_meta.items() %}
    {{ k }} = "{{ v }}"
{% endfor %}
  }
{% endif %}
{% for vol in nomad_host_volumes %}
  host_volume "{{ vol.name }}" {
    path = "{{ vol.path }}"
    read_only = {{ vol.read_only | default(false) | lower }}
  }
{% endfor %}
}

plugin "docker" {
  config {
    extra_labels = ["job_name", "task_group_name", "task_name", "namespace", "node_name"]
    pull_activity_timeout = "10m"
    # false (default): no bind mounts of arbitrary host paths; jobs use the host volumes declared per node
    volumes {
      enabled = {{ cluster_docker_volumes_enabled | bool | lower }}
    }
    # the docker runtimes a job may name (`runtime` in its docker task config): runc, and the gVisor ones (cluster_gvisor_*)
    allow_runtimes = {{ cluster_docker_runtimes_allowed | to_json }}
    # what cap_add may name (see nomad_docker_default_caps); privileged mode stays off (allow_privileged defaults to false)
    allow_caps = {{ (nomad_docker_default_caps + nomad_docker_extra_caps) | unique | to_json }}
    gc {
      image = false
    }
  }
}
