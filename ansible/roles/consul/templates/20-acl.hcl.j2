# {{ ansible_managed }}
acl {
  enabled = true
  default_policy = "deny"
  down_policy = "extend-cache"
  enable_token_persistence = true
  tokens {
{% if consul_is_server %}
    initial_management = "{{ cluster_consul_management_token }}"
{% endif %}
{% if consul_agent_token %}
    agent = "{{ consul_agent_token }}"
{% endif %}
{% if consul_dns_token %}
    dns = "{{ consul_dns_token }}"
{% endif %}
  }
}
