# {{ ansible_managed }}
tls {
  defaults {
    ca_file = "{{ cluster_tls_dir }}/ca.pem"
{% if consul_is_server %}
    cert_file = "{{ cluster_tls_dir }}/consul.pem"
    key_file = "{{ cluster_tls_dir }}/consul.key"
    verify_incoming = true
{% endif %}
    verify_outgoing = true
    # the hybrid post-quantum key exchange first (X25519 + ML-KEM-768), classical X25519 as the fallback (Consul 2.1 and later)
    tls_ecdh_curves = "X25519MLKEM768,X25519"
  }
  internal_rpc {
    tls_min_version = "TLSv1_3"
    verify_server_hostname = true
  }
  grpc {
    # a certificate of its own, without ip addresses: envoy cannot verify chains with ip name constraints (role cluster_tls)
    cert_file = "{{ cluster_tls_dir }}/consul-grpc.pem"
    key_file = "{{ cluster_tls_dir }}/consul-grpc.key"
    verify_incoming = false
  }
  # No tls_min_version for grpc: the Envoy sidecars fetch their configuration from it, and with TLS 1.3 as the minimum Envoy's connection to the agent fails
  # (tested with Consul 2.1.0: the sidecar never gets its listeners). So the minimum is set on the listeners one by one, not in defaults.
  https {
    tls_min_version = "TLSv1_3"
    # auto_encrypt certs come from consul's own connect CA, so the local https api (used by
    # nomad, traefik, the cli) serves the node leaf cert signed by the cluster CA instead
    cert_file = "{{ cluster_tls_dir }}/consul.pem"
    key_file = "{{ cluster_tls_dir }}/consul.key"
    # browsers / cli have no client cert; access is controlled by ACL tokens instead
    verify_incoming = false
  }
}

{% if consul_is_server %}
# servers hand out client certs, clients need no cert files of their own
auto_encrypt {
  allow_tls = true
}
{% else %}
auto_encrypt {
  tls = true
}
{% endif %}
