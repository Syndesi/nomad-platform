# {{ ansible_managed }}
# instance {{ authelia_inst.name }} (authelia_inst: name, port, domain = cookie domain, secrets, rules)
theme: dark
log:
  level: info
  format: json
server:
  address: 'tcp://:{{ authelia_inst.port }}'
  # the image's own docker HEALTHCHECK needs a file in /app that authelia writes at startup; the root filesystem is read-only and nomad / consul
  # check /api/health themselves
  disable_healthcheck: true
  # https: traefik's forward-auth calls (session cookies) cross the cluster network. The certificate is the node's own, made by role
  # cluster_tls, mounted from the node (host volume authelia-tls, jobs/authelia.nomad.hcl); traefik verifies it with the cluster CA.
  tls:
    certificate: /tls/authelia.pem
    key: /tls/authelia.key
  timeouts:
    read: 6s
    write: 6s
    idle: 30s
  endpoints:
    authz:
      forward-auth:
        implementation: ForwardAuth
        authn_strategies:
          # the session cookie only: a header login (Basic) can never be more than one factor, and every rule is two_factor
          - name: CookieSession
# Second factor: TOTP. The shared secret of each user comes from the sops-encrypted authelia_totp_seeds and is registered by the deploy
# (`authelia storage user totp import`, role authelia_totp), so nobody has to go through the identity verification of the portal.
# WebAuthn is off unless authelia_webauthn is true (registering a key needs the one-time code of the notifier, see README).
totp:
  disable: false
  issuer: {{ authelia_inst.issuer | to_json }}
  algorithm: SHA1
  digits: 6
  period: 30
  skew: 1
  allowed_algorithms: [SHA1]
  allowed_digits: [6]
  allowed_periods: [30]
  disable_reuse_security_policy: false
webauthn:
  disable: {{ (not authelia_webauthn | bool) | lower }}
  display_name: {{ authelia_inst.issuer | to_json }}
default_2fa_method: totp
# Failed logins are counted per USERNAME: whoever knows a name can lock that account for ban_time (an unknown name locks nothing).
# So: keep the names unlisted, the bans short, the retries moderate.
regulation:
  max_retries: {{ authelia_regulation_max_retries }}
  find_time: {{ authelia_regulation_find_time }}
  ban_time: {{ authelia_regulation_ban_time }}
access_control:
  default_policy: deny
  rules:
    # traefik asks authelia about EVERY request of the websecure entry point (default middleware), the login portal's own names included
    - domain:
        - {{ ('auth.' ~ authelia_inst.domain) | to_json }}
      policy: bypass
{% for rule in authelia_inst.rules %}
    - domain:
{% for d in (rule.domain if rule.domain is not string else [rule.domain]) %}
        - {{ d | to_json }}
{% endfor %}
      policy: {{ rule.policy | to_json }}
{% if rule.networks | default([]) %}
      networks:
{% for n in rule.networks %}
        - {{ n | to_json }}
{% endfor %}
{% endif %}
{% if rule.subject | default([]) %}
      subject:
{% for s in rule.subject %}
        - [{{ s | to_json }}]
{% endfor %}
{% endif %}
{% endfor %}
{% if authelia_inst.oidc | default({}) %}
# OpenID Connect provider (RFC 8414 discovery at /.well-known/openid-configuration): applications log in with the accounts of this instance and its second factor
identity_providers:
  oidc:
    hmac_secret: {{ authelia_inst.oidc.hmac_secret | to_json }}
    jwks:
      - key_id: main
        algorithm: RS256
        use: sig
        key: |
{{ authelia_inst.oidc.jwks_key | indent(10, true) }}
    # Authelia 4.39 puts claims into the ID token only on request: the groups (Grafana maps them to its roles) and the profile
    claims_policies:
      standard:
        id_token: [groups, email, email_verified, name, preferred_username]
    clients:
{% for c in authelia_inst.oidc.clients %}
      - client_id: {{ c.id | to_json }}
        client_name: {{ c.name | to_json }}
        client_secret: {{ c.secret_hash | to_json }}
        claims_policy: standard
        public: false
        authorization_policy: two_factor
        # first party and behind a second factor already: no consent page
        consent_mode: implicit
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
{% for u in c.redirect_uris %}
          - {{ u | to_json }}
{% endfor %}
        scopes: [openid, profile, email, groups]
        response_types: [code]
        grant_types: [authorization_code]
        token_endpoint_auth_method: client_secret_basic
{% endfor %}
{% endif %}
authentication_backend:
  refresh_interval: 5m
  password_reset:
    disable: true
  password_change:
    disable: true
  file:
    path: /secrets/users.yml
identity_validation:
  reset_password:
    jwt_secret: {{ authelia_inst.jwt_secret | to_json }}
session:
  # sessions are in memory (no redis): they end with the authelia process, a redeploy logs everybody out. The second factors do not (storage below).
  secret: {{ authelia_inst.session_secret | to_json }}
  inactivity: {{ authelia_session_inactivity }}
  expiration: {{ authelia_session_expiration }}
  remember_me: {{ authelia_session_remember_me }}
  cookies:
    - domain: {{ authelia_inst.domain | to_json }}
      authelia_url: {{ ('https://auth.' ~ authelia_inst.domain) | to_json }}
      same_site: lax
storage:
  encryption_key: {{ authelia_inst.storage_key | to_json }}
  local:
    # the host volume of the instance (data_volume, see jobs/authelia.nomad.hcl): totp secrets, devices, bans
    path: /data/db.sqlite3
notifier:
  filesystem:
    filename: /data/notification.txt
