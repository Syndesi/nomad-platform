#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Replaces the table in one transaction (docker's and nomad's own tables are not touched).
table inet {{ cluster_firewall_table }}
delete table inet {{ cluster_firewall_table }}

table inet {{ cluster_firewall_table }} {
  chain input {
    type filter hook input priority filter; policy drop;

    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop

    # icmp (ping, path mtu) and ipv6 neighbour discovery; replies of the dhcp servers
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    # DHCP replies: from the uplink only (not from the container bridges or any other interface)
    iifname "{{ cluster_interface_effective }}" udp sport 67 udp dport 68 accept
    iifname "{{ cluster_interface_effective }}" udp sport 547 udp dport 546 accept

    # ssh from anywhere, except from the container bridges (a compromised workload gets no path to sshd)
    iifname { "docker0", "nomad", "br-*" } tcp dport 22 drop
{% if cluster_firewall_ssh_rate | trim %}
    # per source address (IPv6: per /64, a subscriber has a whole prefix); new connections only (an open session is "established" and accepted above); the cluster's own sources are exempt
    ip saddr { {{ cluster_firewall_cluster_sources | join(', ') }} } tcp dport 22 accept
    tcp dport 22 ct state new meter ssh_new { ip saddr timeout 5m limit rate over {{ cluster_firewall_ssh_rate }} burst {{ cluster_firewall_ssh_burst }} packets } drop
    tcp dport 22 ct state new meter ssh_new6 { ip6 saddr and ffff:ffff:ffff:ffff:: timeout 5m limit rate over {{ cluster_firewall_ssh_rate }} burst {{ cluster_firewall_ssh_burst }} packets } drop
{% endif %}
    tcp dport 22 accept

    # containers on the host's bridges: only dns and what cluster_firewall_bridge_*_ports lists, not the whole host
    iifname { "docker0", "nomad", "br-*" } tcp dport { {{ cluster_firewall_bridge_tcp_ports | join(', ') }} } accept
    iifname { "docker0", "nomad", "br-*" } udp dport { {{ cluster_firewall_bridge_udp_ports | join(', ') }} } accept

    # the cluster itself
    ip saddr { {{ cluster_firewall_cluster_sources | join(', ') }} } tcp dport { {{ cluster_firewall_tcp_ports | join(', ') }} } accept
    ip saddr { {{ cluster_firewall_cluster_sources | join(', ') }} } udp dport { {{ cluster_firewall_udp_ports | join(', ') }} } accept
{% if cluster_firewall_public_tcp_ports %}

    # ingress
    tcp dport { {{ cluster_firewall_public_tcp_ports | join(', ') }} } accept
{% endif %}
{% if cluster_firewall_extra_rules | trim %}

    # cluster_firewall_extra_rules
{{ cluster_firewall_extra_rules | indent(4, true) }}
{% endif %}

    counter drop
  }

  # Published job ports (docker/nomad nat): the traffic is dnat'ed and goes through forward, never through input. It is accepted from the
  # cluster and from the container bridges; from anywhere else only the public ports (matched on the original destination port, so a
  # `to` mapping does not matter) pass. Everything else that is dnat'ed is dropped, so a job that publishes a port is not open to the world.
  # Packets routed directly to a container's ip (not dnat'ed) are dropped too, except from the cluster and the bridges.
  chain forward {
    type filter hook forward priority filter; policy drop;

    # replies of connections that were allowed; the rules below only see new ones (docker's own FORWARD chain is not relied on)
    ct state established,related accept
    ct state invalid drop

    # containers of the network "{{ cluster_egress_cni_name }}" (mode = "cni/{{ cluster_egress_cni_name }}") may reach anything
    iifname "{{ cluster_egress_bridge }}" accept
    # every other container: only the cluster and the container networks, not the internet. New connections are rejected at once (an
    # application sees "no route to host", not a timeout).
    iifname { "docker0", "nomad", "br-*" } ip daddr != { {{ cluster_firewall_container_destinations | join(', ') }} } ct state new counter reject with icmp type admin-prohibited
    iifname { "docker0", "nomad", "br-*" } meta nfproto ipv6 ct state new counter reject with icmpv6 type admin-prohibited
    iifname { "docker0", "nomad", "br-*" } accept
    ip saddr { {{ cluster_firewall_cluster_sources | join(', ') }} } accept
    # new connections to a container that are not dnat'ed, i.e. routed straight to its ip (nomad's bridge has no protection of its own)
    oifname { "docker0", "nomad", "br-*" } ct state new ct status & dnat == 0 drop
{% if cluster_firewall_public_tcp_ports %}
    ct status dnat ct original proto-dst { {{ cluster_firewall_public_tcp_ports | join(', ') }} } accept
{% endif %}
    ct status dnat counter drop
    # explicit, not only the policy: anything no rule above allowed
    counter drop
  }

  # dns of the containers: all of them are told to ask {{ cluster_dns_docker_bridge_ip }} (docker's `dns`), where the restricted resolver answers
  # (*.consul and this node's names). The containers of the network "{{ cluster_egress_cni_name }}" are sent to the full resolver instead.
  chain container_dns {
    type nat hook prerouting priority dstnat; policy accept;

    iifname "{{ cluster_egress_bridge }}" ip daddr {{ cluster_dns_docker_bridge_ip }} udp dport 53 dnat ip to {{ cluster_egress_bridge_ip }}
    iifname "{{ cluster_egress_bridge }}" ip daddr {{ cluster_dns_docker_bridge_ip }} tcp dport 53 dnat ip to {{ cluster_egress_bridge_ip }}
  }
}
